<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
 xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:r="urn:lesson:rfq" targetNamespace="urn:lesson:rfq">
 <wsdl:types><xs:schema><xs:import namespace="urn:lesson:rfq" schemaLocation="rfq.xsd"/></xs:schema></wsdl:types>
 <wsdl:message name="GetRFQInput"><wsdl:part name="parameters" element="r:GetRFQ"/></wsdl:message>
 <wsdl:message name="GetRFQOutput"><wsdl:part name="parameters" element="r:Records"/></wsdl:message>
 <wsdl:portType name="RFQPortType"><wsdl:operation name="GetRFQ">
  <wsdl:input message="r:GetRFQInput"/><wsdl:output message="r:GetRFQOutput"/>
 </wsdl:operation></wsdl:portType>
 <wsdl:binding name="RFQBinding" type="r:RFQPortType">
  <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
  <wsdl:operation name="GetRFQ"><soap:operation soapAction="urn:lesson:GetRFQ"/>
   <wsdl:input><soap:body use="literal"/></wsdl:input>
   <wsdl:output><soap:body use="literal"/></wsdl:output>
  </wsdl:operation>
 </wsdl:binding>
 <wsdl:service name="RFQService"><wsdl:port name="RFQPort" binding="r:RFQBinding">
  <soap:address location="https://example.invalid/rfq"/>
 </wsdl:port></wsdl:service>
</wsdl:definitions>
