<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:lesson:rfq"
 xmlns:r="urn:lesson:rfq" elementFormDefault="qualified">
  <xs:element name="GetRFQ"><xs:complexType><xs:sequence>
    <xs:element name="id" type="xs:string"/>
  </xs:sequence></xs:complexType></xs:element>
  <xs:complexType name="Amount"><xs:simpleContent><xs:extension base="xs:decimal">
    <xs:attribute name="currency" type="xs:string" use="required"/>
  </xs:extension></xs:simpleContent></xs:complexType>
  <xs:element name="Records"><xs:complexType><xs:sequence>
    <xs:element name="Record" minOccurs="0" maxOccurs="100"><xs:complexType><xs:sequence>
      <xs:element name="Amount" type="r:Amount"/>
      <xs:element name="Date" type="xs:date"/>
      <xs:element name="Note" type="xs:string" minOccurs="0" nillable="true"/>
    </xs:sequence><xs:attribute name="id" type="xs:string" use="required"/></xs:complexType></xs:element>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
