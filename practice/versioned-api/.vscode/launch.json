{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Versioned API: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "test_versions.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Versioned API: local server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
